DATABASE_URL="mysql+pymysql://hospital_app:replace_me@localhost/hospital_management"
SECRET_KEY="replace_with_a_long_random_secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Required by migration/bootstrap commands. Keep the password backend-only.
APP_ENV="development"
SUPER_ADMIN_EMAIL="your-super-admin-email@example.com"
SUPER_ADMIN_PASSWORD="your-super-admin-password"
SUPER_ADMIN_NAME="Super Admin"

# SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
# Provide your Gmail address
SMTP_USERNAME=""
# Provide your Gmail App Password (not your normal password)
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Hospital Management System"
