# Docker Compose database credentials (choose strong, unique values).
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=hospital_management
MYSQL_USER=hospital_app
MYSQL_PASSWORD=

# Published host ports. Change these if ports 3000 or 8000 are occupied.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Application configuration.
DATABASE_URL=mysql+pymysql://hospital_app:replace_me@localhost/hospital_management
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional SMTP provider; leave blank until configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Hospital Management System
